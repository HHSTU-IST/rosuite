{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Debug Eigen",
            "type": "cppdbg",
            "request": "launch",
            "targetArchitecture": "arm64",
            "program": "${fileDirname}/${fileBasenameNoExtension}",
            "args": [],
            "stopAtEntry": false,
            "externalConsole": false,
            "cwd": "${fileDirname}",
            "MIMode": "lldb",
            "internalConsoleOptions": "openOnSessionStart",
            // "preLaunchTask": "Build Eigen"
        },
        {
            "name": "Debug Eigen on Windows",
            "type": "cppdbg",
            "request": "launch",
            "targetArchitecture": "x86_64",
            "program": "${fileDirname}/${fileBasenameNoExtension}.exe",
            "args": [],
            "stopAtEntry": false,
            "externalConsole": false,
            "cwd": "${fileDirname}",
            "MIMode": "gdb",
            "miDebuggerPath": "${env:SCOOP}\\apps\\msys2-cn\\current\\ucrt64\\bin\\gdb.exe",
            "internalConsoleOptions": "openOnSessionStart",
            // "preLaunchTask": "Build Eigen on Windows"
        }
    ]
}
